                  <ShieldCheck className="w-5 h-5 text-emerald-400" /> Database & Persistence Status
                </h3>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                  <div className="bg-slate-950 p-4 rounded-xl border border-slate-800">
                    <span className="text-slate-500 block mb-1">Local Backup Engine</span>
                    <span className="text-emerald-400 font-mono font-bold">Active (LocalStorage Sync)</span>
                  </div>
                  <div className="bg-slate-950 p-4 rounded-xl border border-slate-800">
                    <span className="text-slate-500 block mb-1">Firebase Cloud Firestore</span>
                    <span className="text-indigo-400 font-mono font-bold">
                      {user ? 'Connected & Live' : 'Anonymous Mode'}
                    </span>
                  </div>
                </div>
              </div>

            </div>
          )}

        </div>
      </main>
    </div>
  );
}
