import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, 
  signInWithCustomToken, 
  signInAnonymously, 
  onAuthStateChanged,
  signOut,
  GoogleAuthProvider,
  signInWithPopup
} from 'firebase/auth';
import { 
  getFirestore, 
  collection, 
  doc, 
  setDoc, 
  onSnapshot, 
  deleteDoc,
  updateDoc
} from 'firebase/firestore';
import { 
  CheckCircle2, 
  Circle, 
  Clock, 
  DollarSign, 
  Plus, 
  Trash2, 
  Edit3, 
  Search, 
  Code, 
  BookOpen, 
  LayoutDashboard, 
  ListTodo, 
  Wallet, 
  FileText, 
  Target, 
  Settings as SettingsIcon, 
  LogOut, 
  Lock, 
  ShieldCheck, 
  Copy, 
  Check, 
  AlertTriangle,
  ArrowUpCircle,
  ArrowDownCircle,
  TrendingUp,
  Tag,
  ChevronRight,
  User,
  ExternalLink,
  Moon,
  Sun
} from 'lucide-react';

// Firebase Configuration Setup
const firebaseConfigStr = typeof __firebase_config !== 'undefined' ? __firebase_config : '{}';
let firebaseConfig = {};
try {
  firebaseConfig = JSON.parse(firebaseConfigStr);
} catch (e) {
  console.warn("Firebase config not available or invalid");
}

const app = firebaseConfig.apiKey ? initializeApp(firebaseConfig) : null;
const auth = app ? getAuth(app) : null;
const db = app ? getFirestore(app) : null;
const appId = typeof __app_id !== 'undefined' ? __app_id : 'life-os-default';

export default function App() {
  // Navigation & User State
  const [activeTab, setActiveTab] = useState('dashboard');
  const [user, setUser] = useState(null);
  const [authLoading, setAuthLoading] = useState(true);

  // Security / Whitelist state (Stored in localStorage or Firestore settings)
  const [whitelistEmail, setWhitelistEmail] = useState(() => {
    return localStorage.getItem('lifeos_owner_email') || '';
  });
  const [tempWhitelist, setTempWhitelist] = useState('');

  // Main Data States (Synced with Firestore / Fallback to LocalStorage)
  const [tasks, setTasks] = useState(() => {
    const saved = localStorage.getItem('lifeos_tasks');
    return saved ? JSON.parse(saved) : [
      { id: '1', title: 'Setup Life OS Authentication', priority: 'High', status: 'Done', category: 'Dev', dueDate: '2026-10-05' },
      { id: '2', title: 'Review Q4 Financial Targets', priority: 'Medium', status: 'In Progress', category: 'Finance', dueDate: '2026-10-10' },
      { id: '3', title: 'Master React & Firebase Integration', priority: 'High', status: 'In Progress', category: 'Learning', dueDate: '2026-10-15' }
    ];
  });

  const [finances, setFinances] = useState(() => {
    const saved = localStorage.getItem('lifeos_finances');
    return saved ? JSON.parse(saved) : [
      { id: '1', description: 'Freelance Project Stipend', amount: 1500, type: 'income', category: 'Work', date: '2026-10-01' },
      { id: '2', description: 'Server Hosting & Domain', amount: 25, type: 'expense', category: 'Infrastructure', date: '2026-10-02' },
      { id: '3', description: 'Books & Learning Resources', amount: 45, type: 'expense', category: 'Education', date: '2026-10-03' }
    ];
  });

  const [notes, setNotes] = useState(() => {
    const saved = localStorage.getItem('lifeos_notes');
    return saved ? JSON.parse(saved) : [
      { id: '1', title: 'Firebase Security Rules Best Practice', content: 'Always restrict Firestore paths using user IDs or exact email matches.\n\n```javascript\nmatch /artifacts/{appId}/public/data/{document=**} {\n  allow read, write: if request.auth != null;\n}\n```', category: 'Code', updatedAt: '2026-10-04' },
      { id: '2', title: 'Life OS Philosophy', content: '1. Keep tasks small and actionable.\n2. Review finances weekly.\n3. Continuous progress over perfection.', category: 'Personal', updatedAt: '2026-10-03' }
    ];
  });

  const [skills, setSkills] = useState(() => {
    const saved = localStorage.getItem('lifeos_skills');
    return saved ? JSON.parse(saved) : [
      { id: '1', title: 'Full Stack Modern Web Dev', progress: 75, targetDate: '2026-12-31', milestones: ['React Mastery', 'Firebase Integration', 'Tailwind Styling', 'Deployment'] },
      { id: '2', title: 'Personal Wealth Management', progress: 50, targetDate: '2026-11-30', milestones: ['Emergency Fund Set', 'Monthly Budgeting', 'Investment Strategy'] }
    ];
  });

  // UI state variables
  const [copiedNoteId, setCopiedNoteId] = useState(null);
  const [taskFilter, setTaskFilter] = useState('All');
  const [noteSearch, setNoteSearch] = useState('');

  useEffect(() => {
    if (!auth) {
      setAuthLoading(false);
      return;
    }

    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth initialization error:", err);
      }
    };

    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
      setAuthLoading(false);
      // Auto whitelist the first user logged in if none is explicitly set
      if (currentUser && currentUser.email && !localStorage.getItem('lifeos_owner_email')) {
        setWhitelistEmail(currentUser.email);
        localStorage.setItem('lifeos_owner_email', currentUser.email);
      }
    });

    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if (!user || !db) return;

    // Realtime listeners for Firestore persistent storage
    const tasksRef = collection(db, 'artifacts', appId, 'users', user.uid, 'tasks');
    const financesRef = collection(db, 'artifacts', appId, 'users', user.uid, 'finances');
    const notesRef = collection(db, 'artifacts', appId, 'users', user.uid, 'notes');
    const skillsRef = collection(db, 'artifacts', appId, 'users', user.uid, 'skills');

    const unsubTasks = onSnapshot(tasksRef, (snapshot) => {
      if (!snapshot.empty) {
        const docsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        setTasks(docsData);
      }
    }, (err) => console.log('Tasks sync notice:', err.message));

    const unsubFinances = onSnapshot(financesRef, (snapshot) => {
      if (!snapshot.empty) {
        const docsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        setFinances(docsData);
      }
    }, (err) => console.log('Finances sync notice:', err.message));

    const unsubNotes = onSnapshot(notesRef, (snapshot) => {
      if (!snapshot.empty) {
        const docsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        setNotes(docsData);
      }
    }, (err) => console.log('Notes sync notice:', err.message));

    const unsubSkills = onSnapshot(skillsRef, (snapshot) => {
      if (!snapshot.empty) {
        const docsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        setSkills(docsData);
      }
    }, (err) => console.log('Skills sync notice:', err.message));

    return () => {
      unsubTasks();
      unsubFinances();
      unsubNotes();
      unsubSkills();
    };
  }, [user]);

  useEffect(() => {
    localStorage.setItem('lifeos_tasks', JSON.stringify(tasks));
  }, [tasks]);

  useEffect(() => {
    localStorage.setItem('lifeos_finances', JSON.stringify(finances));
  }, [finances]);

  useEffect(() => {
    localStorage.setItem('lifeos_notes', JSON.stringify(notes));
  }, [notes]);

  useEffect(() => {
    localStorage.setItem('lifeos_skills', JSON.stringify(skills));
  }, [skills]);

  // Security Check: Is user authorized?
  const isOwner = useMemo(() => {
    if (!whitelistEmail) return true; // Default unlocked until owner specifies an email
    if (!user) return true; // Anonymous default access for immediate preview
    if (!user.email) return true; // Local session allowed
    return user.email.toLowerCase() === whitelistEmail.toLowerCase();
  }, [user, whitelistEmail]);

  // Task Handlers
  const addTask = (title, category, priority, dueDate) => {
    if (!title.trim()) return;
    const newTask = {
      id: Date.now().toString(),
      title,
      category: category || 'General',
      priority: priority || 'Medium',
      status: 'Todo',
      dueDate: dueDate || new Date().toISOString().split('T')[0]
    };
    setTasks(prev => [newTask, ...prev]);

    if (user && db) {
      setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'tasks', newTask.id), newTask);
    }
  };

  const toggleTaskStatus = (id) => {
    setTasks(prev => prev.map(t => {
      if (t.id === id) {
        const nextStatus = t.status === 'Done' ? 'Todo' : t.status === 'Todo' ? 'In Progress' : 'Done';
        const updated = { ...t, status: nextStatus };
        if (user && db) {
          updateDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'tasks', id), { status: nextStatus });
        }
        return updated;
      }
      return t;
    }));
  };

  const deleteTask = (id) => {
    setTasks(prev => prev.filter(t => t.id !== id));
    if (user && db) {
      deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'tasks', id));
    }
  };

  // Finance Handlers
  const addTransaction = (description, amount, type, category) => {
    if (!description.trim() || !amount) return;
    const newTx = {
      id: Date.now().toString(),
      description,
      amount: parseFloat(amount),
      type,
      category: category || 'General',
      date: new Date().toISOString().split('T')[0]
    };
    setFinances(prev => [newTx, ...prev]);

    if (user && db) {
      setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'finances', newTx.id), newTx);
    }
  };

  const deleteTransaction = (id) => {
    setFinances(prev => prev.filter(f => f.id !== id));
    if (user && db) {
      deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'finances', id));
    }
  };

  // Note Handlers
  const addNote = (title, content, category) => {
    if (!title.trim()) return;
    const newNote = {
      id: Date.now().toString(),
      title,
      content,
      category: category || 'General',
      updatedAt: new Date().toISOString().split('T')[0]
    };
    setNotes(prev => [newNote, ...prev]);

    if (user && db) {
      setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'notes', newNote.id), newNote);
    }
  };

  const deleteNote = (id) => {
    setNotes(prev => prev.filter(n => n.id !== id));
    if (user && db) {
      deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'notes', id));
    }
  };

  // Skill Handlers
  const addSkill = (title, targetDate) => {
    if (!title.trim()) return;
    const newSkill = {
      id: Date.now().toString(),
      title,
      progress: 0,
      targetDate: targetDate || '2026-12-31',
      milestones: ['Initial Setup', 'Practice Basics', 'Complete Final Project']
    };
    setSkills(prev => [...prev, newSkill]);

    if (user && db) {
      setDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'skills', newSkill.id), newSkill);
    }
  };

  const updateSkillProgress = (id, newProgress) => {
    setSkills(prev => prev.map(s => {
      if (s.id === id) {
        const updated = { ...s, progress: Math.min(100, Math.max(0, newProgress)) };
        if (user && db) {
          updateDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'skills', id), { progress: updated.progress });
        }
        return updated;
      }
      return s;
    }));
  };

  const deleteSkill = (id) => {
    setSkills(prev => prev.filter(s => s.id !== id));
    if (user && db) {
      deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'skills', id));
    }
  };

  // Computed Financial Totals
  const { totalIncome, totalExpenses, balance } = useMemo(() => {
    const inc = finances.filter(f => f.type === 'income').reduce((acc, f) => acc + f.amount, 0);
    const exp = finances.filter(f => f.type === 'expense').reduce((acc, f) => acc + f.amount, 0);
    return { totalIncome: inc, totalExpenses: exp, balance: inc - exp };
  }, [finances]);

  // Auth Action
  const handleGoogleSignIn = async () => {
    if (!auth) return;
    try {
      const provider = new GoogleAuthProvider();
      await signInWithPopup(auth, provider);
    } catch (err) {
      console.error("Login failed:", err);
    }
  };

  const handleSignOut = async () => {
    if (!auth) return;
    await signOut(auth);
  };

  const saveWhitelistSetting = () => {
    setWhitelistEmail(tempWhitelist.trim());
    localStorage.setItem('lifeos_owner_email', tempWhitelist.trim());
    alert('Security Settings Updated: Access restricted to ' + (tempWhitelist.trim() || 'Anyone'));
  };

  if (!isOwner && user) {
    return (
      <div className="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4">
        <div className="max-w-md w-full bg-slate-900 border border-slate-800 rounded-2xl p-6 text-center shadow-2xl">
          <div className="w-16 h-16 bg-red-500/10 text-red-400 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-500/20">
            <Lock className="w-8 h-8" />
          </div>
          <h2 className="text-2xl font-bold mb-2">Access Restricted</h2>
          <p className="text-slate-400 text-sm mb-6">
            This Personal Life OS Dashboard is locked and accessible only by its owner ({whitelistEmail}).
          </p>
          <div className="bg-slate-950 p-4 rounded-xl border border-slate-800 mb-6 text-left text-xs font-mono text-slate-400">
            <div>Current Account: <span className="text-amber-400">{user.email || 'Anonymous'}</span></div>
            <div>Authorized Owner: <span className="text-emerald-400">{whitelistEmail}</span></div>
          </div>
          <button
            onClick={handleSignOut}
            className="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 py-2.5 rounded-xl text-sm font-medium transition flex items-center justify-center gap-2"
          >
            <LogOut className="w-4 h-4" /> Sign Out & Switch Account
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="flex h-screen bg-slate-950 text-slate-100 font-sans overflow-hidden">
      
      {/* Sidebar Navigation */}
      <aside className="w-64 border-r border-slate-800 bg-slate-900/50 backdrop-blur-xl flex flex-col justify-between hidden md:flex">
        <div>
          {/* Logo / Brand */}
          <div className="p-6 border-b border-slate-800/80 flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-bold shadow-inner">
              OS
            </div>
            <div>
              <h1 className="font-bold text-slate-100 leading-none">Life OS</h1>
              <span className="text-xs text-slate-500 font-medium">Personal Workspace</span>
            </div>
          </div>

          {/* Navigation Links */}
          <nav className="p-4 space-y-1.5">
            {[
              { id: 'dashboard', label: 'Dashboard', icon: LayoutDashboard },
              { id: 'tasks', label: 'Tasks & Projects', icon: ListTodo, badge: tasks.filter(t => t.status !== 'Done').length },
              { id: 'finances', label: 'Finance Tracker', icon: Wallet },
              { id: 'notes', label: 'Notes & Code Vault', icon: FileText, badge: notes.length },
              { id: 'skills', label: 'Skill Roadmap', icon: Target },
              { id: 'settings', label: 'Security & Access', icon: SettingsIcon },
            ].map(item => {
              const Icon = item.icon;
              const isActive = activeTab === item.id;
              return (
                <button
                  key={item.id}
                  onClick={() => setActiveTab(item.id)}
                  className={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 ${
                    isActive 
                      ? 'bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 shadow-sm' 
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50'
                  }`}
                >
                  <div className="flex items-center gap-3">
                    <Icon className={`w-4 h-4 ${isActive ? 'text-indigo-400' : 'text-slate-400'}`} />
                    <span>{item.label}</span>
                  </div>
                  {item.badge !== undefined && item.badge > 0 && (
                    <span className="bg-slate-800 text-slate-400 text-xs px-2 py-0.5 rounded-full border border-slate-700">
                      {item.badge}
                    </span>
                  )}
                </button>
              );
            })}
          </nav>
        </div>

        {/* User Account / Auth Status Footer */}
        <div className="p-4 border-t border-slate-800/80 bg-slate-900/30">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2.5 overflow-hidden">
              <div className="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-indigo-400 shrink-0">
                {user && user.email ? user.email.charAt(0).toUpperCase() : <User className="w-4 h-4 text-slate-400" />}
              </div>
              <div className="truncate">
                <p className="text-xs font-medium text-slate-200 truncate">
                  {user ? (user.email || 'Private User') : 'Guest Session'}
                </p>
                <p className="text-[10px] text-emerald-400 flex items-center gap-1">
                  <ShieldCheck className="w-3 h-3" /> Encrypted Vault
                </p>
              </div>
            </div>
            {user ? (
              <button 
                onClick={handleSignOut} 
                title="Sign Out"
                className="p-1.5 text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition"
              >
                <LogOut className="w-4 h-4" />
              </button>
            ) : (
              <button 
                onClick={handleGoogleSignIn} 
                title="Sign In with Google"
                className="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded text-xs font-medium"
              >
                Login
              </button>
            )}
          </div>
        </div>
      </aside>

      {/* Main Content Area */}
      <main className="flex-1 flex flex-col h-screen overflow-hidden bg-slate-950">
        
        {/* Mobile Header */}
        <header className="md:hidden border-b border-slate-800 bg-slate-900 p-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <div className="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center font-bold text-xs text-white">OS</div>
            <span className="font-bold text-sm">Life OS</span>
          </div>
          <div className="flex items-center gap-2 overflow-x-auto">
            {['dashboard', 'tasks', 'finances', 'notes', 'skills', 'settings'].map(tab => (
              <button
                key={tab}
                onClick={() => setActiveTab(tab)}
                className={`px-2.5 py-1 text-xs rounded-lg capitalize ${
                  activeTab === tab ? 'bg-indigo-600 text-white' : 'text-slate-400 bg-slate-800'
                }`}
              >
                {tab}
              </button>
            ))}
          </div>
        </header>

        {/* Dynamic View Panel */}
        <div className="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">
          
          {}
          {activeTab === 'dashboard' && (
            <div className="space-y-6 max-w-7xl mx-auto">
              {/* Welcome Header */}
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gradient-to-r from-indigo-900/30 via-slate-900 to-slate-900 p-6 rounded-2xl border border-indigo-500/20">
                <div>
                  <h2 className="text-2xl font-bold text-slate-100">Welcome Back to Your Life OS</h2>
                  <p className="text-sm text-slate-400 mt-1">Here is a quick overview of your personal goals, finances, and active tasks.</p>
                </div>
                <div className="flex items-center gap-3">
                  <span className="text-xs bg-slate-800 text-indigo-300 border border-indigo-500/20 px-3 py-1.5 rounded-xl font-mono">
                    {new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>
              </div>

              {/* Stat Summary Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div className="bg-slate-900 border border-slate-800 p-5 rounded-2xl relative overflow-hidden">
                  <div className="flex justify-between items-start mb-3">
                    <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pending Tasks</span>
                    <div className="p-2 bg-indigo-500/10 text-indigo-400 rounded-xl border border-indigo-500/20">
                      <ListTodo className="w-5 h-5" />
                    </div>
                  </div>
                  <div className="text-2xl font-bold text-slate-100">
                    {tasks.filter(t => t.status !== 'Done').length}
                  </div>
                  <span className="text-xs text-slate-500 mt-1 block">
                    {tasks.filter(t => t.status === 'Done').length} completed
                  </span>
                </div>

                <div className="bg-slate-900 border border-slate-800 p-5 rounded-2xl relative overflow-hidden">
                  <div className="flex justify-between items-start mb-3">
                    <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Net Balance</span>
                    <div className="p-2 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20">
                      <Wallet className="w-5 h-5" />
                    </div>
                  </div>
                  <div className={`text-2xl font-bold ${balance >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                    ${balance.toLocaleString()}
                  </div>
                  <span className="text-xs text-slate-500 mt-1 block">
                    Income: ${totalIncome} | Exp: ${totalExpenses}
                  </span>
                </div>

                <div className="bg-slate-900 border border-slate-800 p-5 rounded-2xl relative overflow-hidden">
                  <div className="flex justify-between items-start mb-3">
                    <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Active Roadmaps</span>
                    <div className="p-2 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                      <Target className="w-5 h-5" />
                    </div>
                  </div>
                  <div className="text-2xl font-bold text-slate-100">
                    {skills.length}
                  </div>
                  <span className="text-xs text-slate-500 mt-1 block">
                    Avg progress: {skills.length ? Math.round(skills.reduce((a,s)=>a+s.progress,0)/skills.length) : 0}%
                  </span>
                </div>

                <div className="bg-slate-900 border border-slate-800 p-5 rounded-2xl relative overflow-hidden">
                  <div className="flex justify-between items-start mb-3">
                    <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Vault Items</span>
                    <div className="p-2 bg-cyan-500/10 text-cyan-400 rounded-xl border border-cyan-500/20">
                      <FileText className="w-5 h-5" />
                    </div>
                  </div>
                  <div className="text-2xl font-bold text-slate-100">
                    {notes.length}
                  </div>
                  <span className="text-xs text-slate-500 mt-1 block">Notes & Code Snippets</span>
                </div>
              </div>

              {/* Quick Split View: Urgent Tasks & Active Skill Roadmaps */}
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                {/* Immediate Tasks */}
                <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                  <div className="flex items-center justify-between mb-4">
                    <h3 className="font-bold text-slate-200 flex items-center gap-2">
                      <Clock className="w-4 h-4 text-indigo-400" /> Active Priority Tasks
                    </h3>
                    <button onClick={() => setActiveTab('tasks')} className="text-xs text-indigo-400 hover:underline">
                      View All →
                    </button>
                  </div>
                  <div className="space-y-3">
                    {tasks.filter(t => t.status !== 'Done').slice(0, 4).map(task => (
